{
  "name": "radar-oportunidades-testes",
  "private": true,
  "description": "Ferramentas só de teste (emuladores do Firebase e Playwright). O site não depende delas.",
  "scripts": {
    "regras": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-radar \"node firestore/regras.test.mjs\"",
    "e2e": "firebase emulators:exec --config ../firebase.json --only auth,firestore --project demo-radar \"node e2e/contas.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.37.0",
    "playwright": "1.56.1"
  }
}
